# =============================================================================
# Buyer Co-Pilot — environment template. Copy to .env (git-ignored) and fill in.
# Generate every secret with:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
# Production: inject from a secret manager (Vault / AWS SM / Doppler), never commit .env.
# =============================================================================

# ---- Runtime mode: production | development | test
#  production -> engine refuses to boot with weak/missing secrets; web demo identity disabled
COPILOT_ENV=development

# ---- PostgreSQL (docker-compose bootstraps these roles from db/schema.sql)
POSTGRES_PASSWORD=change-me-superuser
COPILOT_APP_DB_PASSWORD=change-me-app            # role copilot_app (engine)
COPILOT_AUTOMATION_DB_PASSWORD=change-me-n8n     # role copilot_automation (n8n Postgres credential)
DATABASE_URL=postgresql://copilot_app:change-me-app@postgres:5432/copilot?sslmode=disable
# Production: use sslmode=verify-full with the provider CA.

# ---- Engine API tokens (>= 32 chars, all DIFFERENT — role separation is enforced)
ENGINE_SERVICE_TOKEN=          # n8n -> engine (automation role: can open gates, cannot decide)
ENGINE_BUYER_PROXY_TOKEN=      # Next.js server -> engine (buyer role, with X-Buyer-Id)
N8N_RESUME_TOKEN=              # engine -> n8n Wait-node resume webhook (header X-Copilot-Resume-Token)
N8N_INTAKE_TOKEN=              # Next.js server -> n8n intake webhook (header X-Copilot-Intake-Token)
RATE_LIMIT_PER_MIN=120

# ---- n8n
N8N_VERSION=                   # REQUIRED: pin a reviewed n8n release (and ideally its image digest)
N8N_BASE_URL=http://n8n:5678   # engine only POSTs resume URLs under this prefix (SSRF guard)
N8N_ENCRYPTION_KEY=            # encrypts n8n credentials at rest — back it up; losing it loses creds
N8N_INTAKE_URL=http://n8n:5678/webhook/buyer-copilot/intake
GENERIC_TIMEZONE=Asia/Kuala_Lumpur

# ---- Web (Next.js server-side only — never prefix these with NEXT_PUBLIC_)
ENGINE_URL=http://engine:8000
COPILOT_DEMO_MODE=false        # true = single fixed demo buyer; ignored when COPILOT_ENV=production
DEMO_BUYER_ID=demo-buyer-001

# ---- Observability (optional)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=buyer-copilot-engine
