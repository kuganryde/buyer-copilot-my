      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "f2209690-4a44-446e-9559-d96f5d7ebfff",
              "leftValue": "={{ $json.transaction.status }}",
              "rightValue": "IN_PROGRESS",
              "operator": {
