    {
      "id": "dbbb8bc5-6b15-56b1-a86e-2ad5b709e8d1",
      "name": "Build Gate Summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "parameters": {
        "jsCode": "\n// Plain-language card for the HITL console. Numbers are copied verbatim from the engine\n// (strings, exact decimals) — this node never does money arithmetic.\nconst txn = $('Load Transaction').item.json.transaction;\nconst vet = $input.first().json;\nconst NEXT = {\n  HITL_1_LISTING_VETTING: ['Order Official Title Search (Carian Rasmi)', 'Site visit: boundary, access, renovations', 'Request valuation'],\n  HITL_2_OFFER_BUDGET: ['Confirm loan pre-approval', 'Issue written offer subject to contract', 'Shortlist conveyancing lawyers'],\n  HITL_3_LAWYER_DEPOSIT: ['Appoint lawyer (check practising certificate)', 'Pay deposit ONLY to lawyer client account as stakeholder', 'Obtain written receipt'],\n  HITL_4_SPA_LOAN_DUTY: ['Sign SPA & loan docs with lawyer', 'Stamp MOT and loan agreement via STAMPS', 'Track state consent / redemption'],\n  HITL_5_TRANSFER_HANDOVER: ['Confirm MOT (Borang 14A) registered', 'Vacant possession checklist & keys', 'Transfer utilities; settle apportionments'],\n};\nreturn [{ json: {\n  transaction_id: txn.id, gate: txn.stage, version: txn.version,\n  summary: {\n    headline: vet.blocking ? 'Blocking risks must be resolved before you can approve.' : 'Ready for your review.',\n    ruleset_version: vet.cost.ruleset_version,\n    cash_at_signing: vet.cost.cash_at_signing,\n    total_cash_to_completion: vet.cost.total_cash_to_completion,\n    mot_duty: vet.cost.mot_duty, loan_duty: vet.cost.loan_duty,\n    exemption_applied: vet.cost.exemption_applied,\n    proposed_scenario: vet.cost.proposed_scenario,\n    line_items: vet.cost.line_items,\n    next_actions: NEXT[txn.stage] ?? [],\n    disclaimer: vet.disclaimer,\n  },\n  flags: vet.flags.map(f => ({ code: String(f.code), severity: String(f.severity), title_en: String(f.title_en ?? ''),\n    title_ms: String(f.title_ms ?? ''), message: String(f.message ?? ''), next_step: String(f.next_step ?? '') })),\n} }];\n"
      }
    },
    {
      "id": "f67abd39-ff4e-5bf2-a865-a0e882f22896",
      "name": "Persist Gate Snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1320,
        200
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_events (transaction_id, gate, event_type, payload, n8n_execution_id) VALUES ($1::uuid, $2::hitl_gate, 'GATE_OPENED', $3::jsonb, $4)",
        "options": {
          "queryReplacement": "={{ [$json.transaction_id, $json.gate, JSON.stringify({summary: $json.summary, flags: $json.flags}), $execution.id] }}"
        }
      },
      "credentials": {
