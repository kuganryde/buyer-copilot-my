    {
      "id": "634c82da-3865-5048-a136-e353a27a700b",
      "name": "Re-load Transaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        200
      ],
      "parameters": {
        "method": "GET",
        "url": "=http://engine:8000/v1/transactions/{{ $('Build Gate Summary').item.json.transaction_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
