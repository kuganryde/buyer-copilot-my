      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "=http://engine:8000/v1/vet",
        "authentication": "genericCredentialType",
