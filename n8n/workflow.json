        }
      },
      "webhookId": "ab3e6447-a8ca-5c2f-96a6-f39cbf1d4fba"
    },
    {
      "id": "33910622-ff76-58ee-9f6b-d5c0035399d2",
      "name": "Validate Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ],
      "parameters": {
        "jsCode": "\n// Untrusted input boundary: validate shape before anything touches the engine or DB.\nconst b = $input.first().json.body ?? {};\nconst UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!UUID.test(String(b.transaction_id ?? ''))) throw new Error('invalid transaction_id');\nif (typeof b.facts !== 'object' || typeof b.purchase !== 'object') throw new Error('facts and purchase are required');\nif (JSON.stringify(b).length > 100000) throw new Error('payload too large');\nreturn [{ json: { transaction_id: b.transaction_id, facts: b.facts, purchase: b.purchase } }];\n"
      }
    },
    {
      "id": "d1a7f234-9fbb-565e-8582-2f380105e020",
      "name": "Load Transaction",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=http://engine:8000/v1/transactions/{{ $json.transaction_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 10000,
          "redirect": {
            "redirect": {
              "followRedirects": false
            }
          }
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_engine_service_token",
          "name": "Copilot Engine Service Token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000
    },
    {
      "id": "54d32052-c7c9-5dd3-9f0e-d7dd5cf2b1fe",
      "name": "Assert In Progress",
