    {
      "id": "9fb6a00d-f4d1-50ad-8329-f59c0e3527bb",
      "name": "Confirm Decision Against Audit Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        200
      ],
      "parameters": {
        "jsCode": "\n// Zero trust: the resume webhook payload is only a hint. The decision is accepted only if\n// the engine/DB holds a matching, hash-chain-valid approval record for this gate.\nconst hint = $('Wait for Human Decision').item.json.body ?? {};\nconst state = $input.first().json;\nconst gate = $('Build Gate Summary').item.json.gate;\nif (!hint.approval_id) {\n  // Timed out after 30 days with no human decision: do nothing automatically.\n  return [{ json: { decision: 'TIMEOUT', transaction_id: state.transaction?.id, gate } }];\n}\nif (!state.audit_chain_valid) throw new Error('AUDIT CHAIN INVALID — halting for investigation');\nconst rec = (state.approvals ?? []).find(a => a.id === hint.approval_id);\nif (!rec || rec.gate !== gate || rec.row_hash !== hint.row_hash || rec.decision !== hint.decision) {\n  throw new Error('Decision not found in audit log or mismatched — refusing to act');\n}\nreturn [{ json: { decision: rec.decision, approval_id: rec.id, row_hash: rec.row_hash, gate,\n                  transaction_id: state.transaction.id, status: state.transaction.status,\n                  next_stage: state.transaction.stage } }];\n"
      }
    },
    {
      "id": "7230877a-7918-57ea-98bf-0c3b5384cd55",
      "name": "Decision Router",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [
        2420,
        200
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "eac3fe37-51a4-45d1-bc50-1f3a036ddf78",
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "APPROVED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "APPROVED"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "a79a0891-85d4-4aaa-912d-3aa3393259ee",
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "CHANGES_REQUESTED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "CHANGES_REQUESTED"
            },
            {
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "strict"
                },
                "conditions": [
                  {
                    "id": "ec3be3f7-f259-403e-adc8-dc542ca71ad4",
                    "leftValue": "={{ $json.decision }}",
                    "rightValue": "REJECTED",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "REJECTED"
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra",
          "renameFallbackOutput": "TIMEOUT_OR_UNKNOWN"
        }
      }
    },
    {
      "id": "1be0e446-39cb-5c5c-b7f1-161db0e70c87",
      "name": "Log Approval",
