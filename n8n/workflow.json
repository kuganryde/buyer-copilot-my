{
  "name": "MY Buyer Co-Pilot — HITL State Machine",
  "nodes": [
    {
      "id": "fcfcdb45-3cb1-5302-91aa-ae7c8e1efba8",
      "name": "Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "buyer-copilot/intake",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "responseCode": 202,
        "options": {
          "rawBody": false
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_intake_token",
