    {
      "id": "a895c021-8806-5a57-b0d9-306998362b71",
      "name": "Find Stale Directory Entries",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        220,
        800
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id::text, agency_name, category, jurisdiction_state, official_url, last_verified_date::text, freshness_status FROM directory_entries_v WHERE is_active AND freshness_status IN ('UNVERIFIED','STALE','PROPOSED_PENDING_GAZETTE') ORDER BY last_verified_date NULLS FIRST LIMIT $1",
        "options": {
          "queryReplacement": "={{ [500] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_postgres_automation",
          "name": "Copilot Postgres (copilot_automation)"
        }
      }
    },
    {
      "id": "cc77569f-d5ba-53be-b5f0-6bbf96b1369e",
      "name": "Any Need Review?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        800
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "1fa01447-48c3-4603-990e-c90731418ca0",
              "leftValue": "={{ $input.all().length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "alwaysOutputData": false
    },
    {
      "id": "52eb01d9-ec97-5451-b22c-f35e246b8bdf",
      "name": "Build Review Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        800
      ],
      "parameters": {
        "jsCode": "\n// A human must re-verify each source; automation never sets last_verified_date itself.\nconst rows = $input.all().map(i => i.json);\nconst by = s => rows.filter(r => r.freshness_status === s).map(r => `${r.agency_name} (${r.jurisdiction_state}) ${r.official_url}`);\nreturn [{ json: { count: rows.length, unverified: by('UNVERIFIED'), stale: by('STALE'),\n                  pending_gazette: by('PROPOSED_PENDING_GAZETTE'),\n                  instruction: 'Verify each source on the official site, then update last_verified_date and verified_by.' } }];\n"
      },
      "executeOnce": true
    },
    {
      "id": "747d18d5-b197-5ce1-9281-c921709e0d5b",
      "name": "Record Freshness Alert",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        880,
        800
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO workflow_events (event_type, payload, n8n_execution_id) VALUES ('DIRECTORY_FRESHNESS_ALERT', $1::jsonb, $2)",
        "options": {
          "queryReplacement": "={{ [JSON.stringify($json), $execution.id] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "REPLACE_postgres_automation",
          "name": "Copilot Postgres (copilot_automation)"
        }
      }
    }
